# Copie este arquivo para ".env" e ajuste os valores conforme seu ambiente.
# NUNCA suba o arquivo ".env" real para o Git (ele já está no .gitignore).

# ---- Banco de dados PostgreSQL ----
# Formato: postgresql://usuario:senha@host:porta/nome_do_banco
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/estoque_app

# ---- Autenticação (JWT) ----
# Gere uma chave forte, por exemplo executando no terminal:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave-por-uma-gerada-com-secrets-token-hex
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- Geral ----
ENVIRONMENT=development
